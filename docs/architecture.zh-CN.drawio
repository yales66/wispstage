<mxfile host="Claude" agent="Claude Code" version="1.0">
  <diagram id="wispstage-arch-zh" name="架构">
    <mxGraphModel dx="1540" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="910" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="D" value="驱动进程（你的场景包 + WispstageKit）" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;fillColor=#f7f7f7;strokeColor=#8a8a8a;swimlaneFillColor=#f7f7f7;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="460" height="646" as="geometry"/></mxCell>
        <mxCell id="T" value="测试宿主进程（第 2 级：你项目里单独的 target）" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;fillColor=#f7f7f7;strokeColor=#8a8a8a;swimlaneFillColor=#f7f7f7;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="420" height="436" as="geometry"/></mxCell>
        <mxCell id="L" value="&lt;b&gt;~/Library/Caches/wispstage/&lt;/b&gt; 锁文件，所有检出目录共用&lt;br&gt;后台：每个包标识一把（独占）+ 全局一把（共享）&lt;br&gt;前台：全局一把（独占）" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="A" value="&lt;b&gt;你或你的编码智能体&lt;/b&gt;&lt;br&gt;wispstage run [过滤条件]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#1e3a5f;fontColor=#ffffff;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="192" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="F" value="&lt;b&gt;build/e2e-runs/&amp;lt;时间&amp;gt;/&lt;/b&gt;&lt;br&gt;summary.txt、results.json&lt;br&gt;每个场景：steps.log、截图、&lt;br&gt;元素裁图、界面文字清单、&lt;br&gt;基准差异图、events.jsonl、&lt;br&gt;app-stderr.log" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="R" value="&lt;b&gt;执行器&lt;/b&gt;&lt;br&gt;每个场景：先取锁，再运行，&lt;br&gt;跑完把截图与基准图比对" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="380" height="74" as="geometry"/></mxCell>
        <mxCell id="S" value="场景的每一步" style="swimlane;startSize=28;align=left;spacingLeft=10;fontStyle=1;fontSize=12.5;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="296" width="420" height="410" as="geometry"/></mxCell>
        <mxCell id="S1" value="1  动作：启动、点击、输入、按键、发命令" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S2" value="2  等界面稳定" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S3" value="3  读界面树，截取窗口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S4" value="&lt;b&gt;4  每个窗口上的检查&lt;/b&gt;&lt;br&gt;&lt;b&gt;判失败：&lt;/b&gt;崩溃或无响应、文字截断、&lt;br&gt;文字压叠或越出窗口、占位符未替换、&lt;br&gt;单复数错误、提示音、应用抢键盘焦点&lt;br&gt;或来到前台&lt;br&gt;&lt;b&gt;只列出：&lt;/b&gt;对比度低、点击目标过小、&lt;br&gt;未对齐、缺无障碍标识、文字被遮挡" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="E" value="最后一个场景跑完：写 summary.txt 和 results.json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="726" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="P" value="&lt;b&gt;你的应用代码&lt;/b&gt;&lt;br&gt;与正式发布的应用同一份代码，不做修改" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="340" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="G" value="&lt;b&gt;Wispstage 舞台库，由 Wispstage.install() 启动&lt;/b&gt;&lt;br&gt;把窗口压在墙纸之下&lt;br&gt;不让应用激活、不让窗口拿键盘焦点&lt;br&gt;把按键事件交给 key 窗口&lt;br&gt;在进程内执行点击、拖拽、悬停、滚动&lt;br&gt;吞掉无人处理按键的提示音并上报&lt;br&gt;不让你真实的点击传到应用的全局监视器" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=12.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="502" width="380" height="136" as="geometry"/></mxCell>
        <mxCell id="Wn" value="&lt;b&gt;应用窗口&lt;/b&gt;&lt;br&gt;压在墙纸之下，从不成为 key 窗口" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="666" width="380" height="48" as="geometry"/></mxCell>
        <mxCell id="N1" value="正式发布的应用是另一个 target，&lt;br&gt;不链接任何 Wispstage 代码。" style="whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#cccc00;fontColor=#1a1a1a;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="742" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="M" value="&lt;b&gt;前台模式（第 0、1 级，不需要测试宿主）：&lt;/b&gt;应用来到前台，点击和按键是真实的系统事件，会移动你的光标。辅助功能、截图和检查的做法不变。&lt;br&gt;若链接了舞台库，它只上报事件。前台运行独占全局锁。" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="1460" height="64" as="geometry"/></mxCell>
        <mxCell id="eAR" value="swift run" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="A" target="R"><mxGeometry relative="1" as="geometry"><mxPoint x="-15.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eAF" value="先读 summary.txt" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="A" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="55.0" y="0.9" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eRL" value="文件锁（flock）" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.9211;exitY=0.0000;exitPerimeter=0;entryX=0.8200;entryY=1.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="R" target="L"><mxGeometry relative="1" as="geometry"><mxPoint x="49.1" y="-23.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eRS" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="R" target="S"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S1" target="S2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e23" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S2" target="S3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e34" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S3" target="S4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="e4F" value="每步的文件" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S4" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="-20.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eEF" value="写入" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="80.5" y="-9.1" as="offset"/><Array as="points"><mxPoint x="165" y="746"/></Array></mxGeometry></mxCell>
        <mxCell id="eGW" value="压到墙纸下" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="G" target="Wn"><mxGeometry relative="1" as="geometry"><mxPoint x="36.8" y="0.9" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h1" value="启动它，设 WISPSTAGE_STAGE=1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.1707;exitPerimeter=0;entryX=0.0000;entryY=0.1857;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h2" value="辅助功能：读界面树、&lt;br&gt;按按钮、设值、选菜单项" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.0000;exitY=0.2878;exitPerimeter=0;entryX=0.0000;entryY=0.5286;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h3" value="可选的命令通道：&lt;br&gt;stdin 发命令，stdout 回事件和应答" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;exitX=1.0000;exitY=0.4049;exitPerimeter=0;entryX=0.0000;entryY=0.8714;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h4" value="按键事件直接发给应用进程&lt;br&gt;（postToPid）" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5854;exitPerimeter=0;entryX=0.0000;entryY=0.2500;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="G"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h5" value="Unix 套接字：送去指针命令，&lt;br&gt;传回提示音和 key 窗口事件" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.0000;exitY=0.7415;exitPerimeter=0;entryX=0.0000;entryY=0.7206;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="G"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h6" value="窗口截图&lt;br&gt;（screencapture -l）" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.9610;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="Wn" target="S"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
