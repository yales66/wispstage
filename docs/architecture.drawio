<mxfile host="Claude" agent="Claude Code" version="1.0">
  <diagram id="wispstage-arch-en" name="Architecture">
    <mxGraphModel dx="1540" dy="910" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="910" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="D" value="Driver process (your scenario package + WispstageKit)" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;fillColor=#f7f7f7;strokeColor=#8a8a8a;swimlaneFillColor=#f7f7f7;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="460" height="646" as="geometry"/></mxCell>
        <mxCell id="T" value="Test host process (level 2: a separate target in your project)" style="swimlane;startSize=30;align=left;spacingLeft=10;fontStyle=1;fontSize=13;html=1;fillColor=#f7f7f7;strokeColor=#8a8a8a;swimlaneFillColor=#f7f7f7;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="1080" y="296" width="420" height="436" as="geometry"/></mxCell>
        <mxCell id="L" value="&lt;b&gt;~/Library/Caches/wispstage/&lt;/b&gt; lock files, shared by every checkout&lt;br&gt;background: one per bundle ID (exclusive) + the global one (shared)&lt;br&gt;foreground: the global one (exclusive)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="360" y="30" width="500" height="80" as="geometry"/></mxCell>
        <mxCell id="A" value="&lt;b&gt;You or your coding agent&lt;/b&gt;&lt;br&gt;wispstage run [filter]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e3a5f;strokeColor=#1e3a5f;fontColor=#ffffff;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="192" width="230" height="70" as="geometry"/></mxCell>
        <mxCell id="F" value="&lt;b&gt;build/e2e-runs/&amp;lt;time&amp;gt;/&lt;/b&gt;&lt;br&gt;summary.txt, results.json&lt;br&gt;per scenario: steps.log, screenshots,&lt;br&gt;element crops, UI text listings,&lt;br&gt;baseline diffs, events.jsonl,&lt;br&gt;app-stderr.log" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="R" value="&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;for each scenario: take the lock, run it,&lt;br&gt;then compare its screenshots with the baselines" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="190" width="380" height="74" as="geometry"/></mxCell>
        <mxCell id="S" value="Each step of your scenario" style="swimlane;startSize=28;align=left;spacingLeft=10;fontStyle=1;fontSize=12.5;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;" vertex="1" parent="1"><mxGeometry x="400" y="296" width="420" height="410" as="geometry"/></mxCell>
        <mxCell id="S1" value="1  Act: launch, click, type, press a key, send a command" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S2" value="2  Wait until the UI stops changing" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="400" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S3" value="3  Read the UI tree and capture the windows" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="460" width="380" height="38" as="geometry"/></mxCell>
        <mxCell id="S4" value="&lt;b&gt;4  Checks on every window&lt;/b&gt;&lt;br&gt;&lt;b&gt;Fail the step:&lt;/b&gt; crash or hang, truncated text,&lt;br&gt;overlapping or out-of-window text, placeholders,&lt;br&gt;plural errors, beeps, the app taking key focus&lt;br&gt;or coming to the front&lt;br&gt;&lt;b&gt;Listed for review:&lt;/b&gt; low contrast, small click targets,&lt;br&gt;misaligned items, missing identifiers, covered text" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="520" width="380" height="170" as="geometry"/></mxCell>
        <mxCell id="E" value="After the last scenario: write summary.txt and results.json" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="420" y="726" width="380" height="40" as="geometry"/></mxCell>
        <mxCell id="P" value="&lt;b&gt;Your app code&lt;/b&gt;&lt;br&gt;the same code as your release app, unchanged" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="340" width="380" height="140" as="geometry"/></mxCell>
        <mxCell id="G" value="&lt;b&gt;Wispstage stage library, started by Wispstage.install()&lt;/b&gt;&lt;br&gt;keeps windows beneath the wallpaper&lt;br&gt;stops the app from activating or taking key focus&lt;br&gt;delivers key events to the key window&lt;br&gt;carries out clicks, drags, hovers and scrolls in-process&lt;br&gt;silences beeps for unhandled keys and reports them&lt;br&gt;keeps your real clicks away from the app's global monitors" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=12.5;align=left;spacingLeft=10;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="502" width="380" height="136" as="geometry"/></mxCell>
        <mxCell id="Wn" value="&lt;b&gt;App windows&lt;/b&gt;&lt;br&gt;beneath the wallpaper, never key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="666" width="380" height="48" as="geometry"/></mxCell>
        <mxCell id="N1" value="Your release app is another target&lt;br&gt;and links no Wispstage code." style="whiteSpace=wrap;html=1;fillColor=#ffffcc;strokeColor=#cccc00;fontColor=#1a1a1a;fontSize=11.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1100" y="742" width="380" height="46" as="geometry"/></mxCell>
        <mxCell id="M" value="&lt;b&gt;Foreground mode (levels 0 and 1, no test host needed):&lt;/b&gt; the app comes to the front, and clicks and keys are real system events that move your cursor.&lt;br&gt;Accessibility, screenshots and checks work the same way. The stage library, if linked, only reports events. A foreground run holds the global lock exclusively." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1a1a1a;fontSize=12.5;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="816" width="1460" height="64" as="geometry"/></mxCell>
        <mxCell id="eAR" value="swift run" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.5000;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="A" target="R"><mxGeometry relative="1" as="geometry"><mxPoint x="-15.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eAF" value="reads summary.txt first" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="A" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="69.0" y="0.9" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eRL" value="file lock (flock)" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;dashed=1;exitX=0.9211;exitY=0.0000;exitPerimeter=0;entryX=0.8200;entryY=1.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="R" target="L"><mxGeometry relative="1" as="geometry"><mxPoint x="44.6" y="-23.1" as="offset"/></mxGeometry></mxCell>
