        <mxCell id="e4F" value="per-step files" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S4" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="-20.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="eEF" value="writes" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.0000;exitY=0.5000;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="E" target="F"><mxGeometry relative="1" as="geometry"><mxPoint x="80.5" y="-9.1" as="offset"/><Array as="points"><mxPoint x="165" y="746"/></Array></mxGeometry></mxCell>
        <mxCell id="eGW" value="hides" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=0.5000;exitY=1.0000;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="G" target="Wn"><mxGeometry relative="1" as="geometry"><mxPoint x="21.9" y="0.9" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h1" value="launches it with WISPSTAGE_STAGE=1" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=none;startFill=1;exitX=1.0000;exitY=0.1707;exitPerimeter=0;entryX=0.0000;entryY=0.1857;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-9.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h2" value="Accessibility: read the UI tree,&lt;br&gt;press, set values, pick menu items" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=block;startFill=1;exitX=1.0000;exitY=0.2878;exitPerimeter=0;entryX=0.0000;entryY=0.5286;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
        <mxCell id="h3" value="optional command channel:&lt;br&gt;stdin commands, stdout events and replies" style="edgeStyle=none;rounded=0;html=1;strokeColor=#444444;strokeWidth=1.6;endArrow=block;endFill=1;startArrow=block;startFill=1;dashed=1;exitX=1.0000;exitY=0.4049;exitPerimeter=0;entryX=0.0000;entryY=0.8714;entryPerimeter=0;labelBackgroundColor=#ffffff;fontSize=11.5;fontColor=#222222;" edge="1" parent="1" source="S" target="P"><mxGeometry relative="1" as="geometry"><mxPoint x="0.0" y="-16.1" as="offset"/></mxGeometry></mxCell>
